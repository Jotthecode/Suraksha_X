# Copy to server/.env for local runs. On Render, set these in the dashboard (render.yaml creates most of them).

# Postgres connection string. Leave empty locally to use a SQLite file (server/surakshax.db).
DATABASE_URL=

# Long random string that signs login tokens (python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=

# Login for the police / admin SOS dashboard at /police_dashboard (disabled while ADMIN_PASSWORD is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Public URL of this server, used in tracking links, e.g. https://surakshax-api.onrender.com
PUBLIC_BASE_URL=

# Identifies the app to OpenStreetMap services (their usage policy asks for a contact)
OSM_USER_AGENT=SurakshaX/3.0 (contact: you@example.com)

# Optional: send SOS SMS + a voice call from the server too
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
