{
  "expo": {
    "name": "SurakshaX",
    "slug": "surakshax",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#D32F2F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aarjoo.surakshax"
    },
    "android": {
      "package": "com.aarjoo.surakshax",
      "adaptiveIcon": {
        "backgroundColor": "#D32F2F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "CALL_PHONE",
        "SEND_SMS",
        "VIBRATE",
        "INTERNET"
      ],
      "versionCode": 21
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "SurakshaX listens for distress words like \"Bachao\" or \"Help\" to trigger SOS hands-free."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SurakshaX uses your location to share it with your guardians during an SOS and to estimate area safety."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SurakshaX listens for your distress words and code phrases to start an SOS hands-free.",
          "speechRecognitionPermission": "SurakshaX turns speech into text on your phone to recognise your code phrases.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "SurakshaX uses motion to detect a phone shake or sudden running and start an SOS."
        }
      ],
      "expo-font"
    ]
  }
}
