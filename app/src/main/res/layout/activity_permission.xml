<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#004D40"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Permissions"
        app:titleTextColor="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/pendant_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allow Access for Safety"
            android:textSize="18sp"
            android:layout_marginTop="20dp"
            android:textStyle="bold"/>

        <CheckBox
            android:id="@+id/checkGPS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable GPS Tracking"
            android:layout_marginTop="30dp" />

        <CheckBox
            android:id="@+id/checkContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Emergency Contacts" />

        <Button
            android:id="@+id/btnProceed"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="PROCEED TO DASHBOARD"
            android:backgroundTint="#004D40"
            android:textColor="#FFFFFF"
            android:layout_marginTop="40dp" />

    </LinearLayout>
</LinearLayout>